      <bpmn:sequenceFlow id="Flow_194scql" name="Sim" sourceRef="Gateway_1dcneoq" targetRef="Event_1f2i8th">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_0yjycnv" name="Processo de Parecer">
      <bpmn:documentation>Processo geralmente consiste de 3 etapas:
1) Envio das informações do Formulário para seu Endpoint dedicado.
2) Analise das informações pela Entidade
3) Enviar mensagem de aprovação do Formulário.

Caso seja Formulário seja rejeitado, 1 etapa extra ocorrerá:
3) Enviar mensagem de reprovação do Formulário.
4) Destacar problemas encontrados com o Formulário

Para execução desses passos ocorrerem, é necessário que as seguintes variáveis sejam corretamente definidas:
1) Estado: Define tipo de aprovação e entidade responsável por ela, permite Backend direcionar informações para Endpoint correto.

Como saída, é definido uma variavel que receberá a mensagem de aprovação do usuário.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Aprovacao_ComiteEticaHumano&#34;" target="Estado" />
          <zeebe:output source="=Aprovado" target="AprovadoCampus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04tdptr</bpmn:incoming>
      <bpmn:incoming>Flow_05eit70</bpmn:incoming>
      <bpmn:incoming>Flow_0zrrqt6</bpmn:incoming>
      <bpmn:outgoing>Flow_1ij0zen</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_04p44m7" name="Adicionar à pendências">
        <bpmn:documentation>Irá adicionar informações do Formulário ao Endpoint definido à Entidade determinada na Entrada do Processo.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="adicionar-pendencias-aprovacao" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1oi4kjp</bpmn:incoming>
        <bpmn:outgoing>Flow_10h7ke3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_0vsue8r" name="Aprovado?">
        <bpmn:documentation>Decisão define caminho a ser tomado pelo sistema.</bpmn:documentation>
        <bpmn:incoming>Flow_0b2jobh</bpmn:incoming>
        <bpmn:outgoing>Flow_14pqqyj</bpmn:outgoing>
        <bpmn:outgoing>Flow_0a84h5t</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Activity_0h8e645" name="Destacar problemas">
        <bpmn:documentation>Entidade irá comentar e destacar problemas encontrados diante o Formulário em uma mensagem para o Docente.</bpmn:documentation>
        <bpmn:incoming>Flow_14pqqyj</bpmn:incoming>
        <bpmn:outgoing>Flow_0rodq0p</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Event_16orekx" name="Fim">
        <bpmn:documentation>Finalisação do subprocesso de Parecer</bpmn:documentation>
        <bpmn:incoming>Flow_0rodq0p</bpmn:incoming>
        <bpmn:incoming>Flow_0a84h5t</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0b2jobh" sourceRef="Activity_00yv64z" targetRef="Gateway_0vsue8r" />
      <bpmn:sequenceFlow id="Flow_0rodq0p" sourceRef="Activity_0h8e645" targetRef="Event_16orekx" />
      <bpmn:sequenceFlow id="Flow_10h7ke3" sourceRef="Activity_04p44m7" targetRef="Activity_00yv64z" />
      <bpmn:sequenceFlow id="Flow_1oi4kjp" sourceRef="Event_17txtvm" targetRef="Activity_04p44m7" />
      <bpmn:startEvent id="Event_17txtvm" name="Início">
        <bpmn:documentation>Início do subprocesso de Parecer das Entidades responsáveis pela aprovação de Projetos.</bpmn:documentation>
        <bpmn:outgoing>Flow_1oi4kjp</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_14pqqyj" name="Não" sourceRef="Gateway_0vsue8r" targetRef="Activity_0h8e645">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:receiveTask id="Activity_00yv64z" name="Parecer Realizado" messageRef="Message_0dlkast">
        <bpmn:documentation>Entidade visualiza em lista em sua janela informações de todos os cadastros de Grupos de Pesquisa pendentes.

Entidade irá enviar mensagem definindo decisão de aprovação ou rejeição.</bpmn:documentation>
        <bpmn:incoming>Flow_10h7ke3</bpmn:incoming>
        <bpmn:outgoing>Flow_0b2jobh</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sequenceFlow id="Flow_0a84h5t" name="Sim" sourceRef="Gateway_0vsue8r" targetRef="Event_16orekx">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
