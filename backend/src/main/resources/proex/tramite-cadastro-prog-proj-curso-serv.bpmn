        <bpmn:documentation>Decisão define caminho a ser tomado pelo sistema.</bpmn:documentation>
        <bpmn:incoming>Flow_0f79wih</bpmn:incoming>
        <bpmn:outgoing>Flow_0cxby9g</bpmn:outgoing>
        <bpmn:outgoing>Flow_0n27can</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Activity_05vpd5m" name="Destacar problemas">
        <bpmn:documentation>Entidade irá comentar e destacar problemas encontrados diante o Formulário em uma mensagem para o Docente.</bpmn:documentation>
        <bpmn:incoming>Flow_0cxby9g</bpmn:incoming>
        <bpmn:outgoing>Flow_0b08txg</bpmn:outgoing>
