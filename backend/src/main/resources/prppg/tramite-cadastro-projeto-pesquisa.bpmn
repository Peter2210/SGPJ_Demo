    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_174my3e" name="Necessário Comitê Animal" sourceRef="Gateway_0jyepds" targetRef="Activity_1hdq7h8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ComiteEticaAnimal=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0q2an0q" name="Necessário Comitê Humano" sourceRef="Gateway_0jyepds" targetRef="Activity_0eqi40w">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ComiteEticaHumana=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:subProcess id="Activity_0eqi40w" name="Processo de Parecer">
      <bpmn:documentation>Processo geralmente consiste de 3 etapas:
1) Envio das informações do Formulário para seu Endpoint dedicado.
2) Analise das informações pela Entidade
3) Enviar mensagem de aprovação do Formulário.

Caso seja Formulário seja rejeitado, 1 etapa extra ocorrerá:
3) Enviar mensagem de reprovação do Formulário.
4) Destacar problemas encontrados com o Formulário

Para execução desses passos ocorrerem, é necessário que as seguintes variáveis sejam corretamente definidas:
1) Estado: Define tipo de aprovação e entidade responsável por ela, permite Backend direcionar informações para Endpoint correto.

Como saída, é definido uma variavel que receberá a mensagem de aprovação do usuário.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Aprovacao_ComiteEticaHumano&#34;" target="Estado" />
          <zeebe:output source="=Aprovado" target="AprovadoCEH" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0q2an0q</bpmn:incoming>
      <bpmn:outgoing>Flow_0utidte</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_0zdyeqf" name="Adicionar à pendências">
        <bpmn:documentation>Irá adicionar informações do Formulário ao Endpoint definido à Entidade determinada na Entrada do Processo.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="adicionar-pendencias-aprovacao" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0os6p5a</bpmn:incoming>
        <bpmn:outgoing>Flow_1xj3dzh</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_0skp9ph" name="Aprovado?">
        <bpmn:documentation>Decisão define caminho a ser tomado pelo sistema.</bpmn:documentation>
        <bpmn:incoming>Flow_0vs5jqw</bpmn:incoming>
        <bpmn:outgoing>Flow_0gxqgpt</bpmn:outgoing>
        <bpmn:outgoing>Flow_1o6wqcr</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="Activity_02v7iqf" name="Destacar problemas">
        <bpmn:documentation>Entidade irá comentar e destacar problemas encontrados diante o Formulário em uma mensagem para o Docente.</bpmn:documentation>
        <bpmn:incoming>Flow_0gxqgpt</bpmn:incoming>
        <bpmn:outgoing>Flow_0uy46gn</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Event_1wshufu" name="Fim">
        <bpmn:documentation>Finalisação do subprocesso de Parecer</bpmn:documentation>
        <bpmn:incoming>Flow_0uy46gn</bpmn:incoming>
        <bpmn:incoming>Flow_1o6wqcr</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0os6p5a" sourceRef="Event_01ffbkh" targetRef="Activity_0zdyeqf" />
      <bpmn:sequenceFlow id="Flow_0uy46gn" sourceRef="Activity_02v7iqf" targetRef="Event_1wshufu" />
      <bpmn:sequenceFlow id="Flow_0vs5jqw" sourceRef="Activity_1kxinx2" targetRef="Gateway_0skp9ph" />
      <bpmn:sequenceFlow id="Flow_1xj3dzh" sourceRef="Activity_0zdyeqf" targetRef="Activity_1kxinx2" />
      <bpmn:startEvent id="Event_01ffbkh" name="Início">
        <bpmn:documentation>Início do subprocesso de Parecer das Entidades responsáveis pela aprovação de Projetos.</bpmn:documentation>
        <bpmn:outgoing>Flow_0os6p5a</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0gxqgpt" name="Não" sourceRef="Gateway_0skp9ph" targetRef="Activity_02v7iqf">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:receiveTask id="Activity_1kxinx2" name="Parecer Realizado" messageRef="Message_09qb2g8">
        <bpmn:documentation>Entidade visualiza em lista em sua janela informações de todos os cadastros de Grupos de Pesquisa pendentes.

Entidade irá enviar mensagem definindo decisão de aprovação ou rejeição.</bpmn:documentation>
        <bpmn:incoming>Flow_1xj3dzh</bpmn:incoming>
        <bpmn:outgoing>Flow_0vs5jqw</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:sequenceFlow id="Flow_1o6wqcr" name="Sim" sourceRef="Gateway_0skp9ph" targetRef="Event_1wshufu">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
