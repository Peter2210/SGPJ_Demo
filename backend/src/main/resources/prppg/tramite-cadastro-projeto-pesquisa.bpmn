    <bpmn:parallelGateway id="Gateway_0hbakds">
      <bpmn:documentation>Necessário aprovação de ambas entidades para continuação, portanto necessário parelelizar, permitindo continuação somente se ambas aprovarem.</bpmn:documentation>
      <bpmn:incoming>Flow_1i7eoo6</bpmn:incoming>
      <bpmn:outgoing>Flow_0619i6h</bpmn:outgoing>
      <bpmn:outgoing>Flow_1brm22c</bpmn:outgoing>
    </bpmn:parallelGateway>
