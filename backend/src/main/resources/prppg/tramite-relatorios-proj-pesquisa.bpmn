    <bpmn:sequenceFlow id="Flow_1auc5rv" name="Sim" sourceRef="Gateway_1y5jptk" targetRef="Activity_1vk1ea5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Final == true</bpmn:conditionExpression>
