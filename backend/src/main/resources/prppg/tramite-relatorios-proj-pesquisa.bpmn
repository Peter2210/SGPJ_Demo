      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=GrupoReprovado == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1r9wosf" sourceRef="Activity_1atjpcv" targetRef="Event_11r9hm5" />
    <bpmn:sequenceFlow id="Flow_0vbpds9" name="Não" sourceRef="Gateway_0xnsepl" targetRef="Gateway_1y5jptk">
