  <bpmn:process id="enviar-relatorios-pesquisa" name="TRAMITE DE ENVIO DE RELATÓRIOS" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1d4y5c4">
      <bpmn:lane id="Lane_0ae4505" name="PRÓ-REITORIA DE PÓS-GRADUAÇÃO">
