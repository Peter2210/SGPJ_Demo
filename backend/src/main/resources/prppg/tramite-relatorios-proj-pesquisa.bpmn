    <bpmn:sequenceFlow id="Flow_10ppip6" name="Não" sourceRef="Gateway_1y5jptk" targetRef="Event_0078yaz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Final == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="StartEvent_1" name="Relatórios salvo no MSSQL">
      <bpmn:outgoing>Flow_0z5vsu2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1gjff6s">
        <bpmn:targetRef>DataStoreReference_02xi99q</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1moxktg" name="100% Aprovados?">
      <bpmn:incoming>Flow_1m7bo1n</bpmn:incoming>
      <bpmn:outgoing>Flow_03asyub</bpmn:outgoing>
      <bpmn:outgoing>Flow_1sc6k8z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_09ydfpz" name="Definir Pesquisadores Inadimplentes">
      <bpmn:documentation>Cada Pesquisador será marcado como inadimplente pelo sistema devido ao fracasso de atingir pontuação mínima. 
Além disso, Pesquisador será retirado do Grupo de Pesquisa relacionado ao relátorio.</bpmn:documentation>
      <bpmn:incoming>Flow_03asyub</bpmn:incoming>
      <bpmn:outgoing>Flow_1wceg17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_0scondb" name="Verificação de status de Grupo">
      <bpmn:documentation>Esperará o envio da mensagem ..., definida após analise das pontuações dos pesquisadores do Grupo no último relatório</bpmn:documentation>
      <bpmn:incoming>Flow_1wceg17</bpmn:incoming>
      <bpmn:outgoing>Flow_1rq6lvn</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_06kxmpe" messageRef="Message_0g845lk" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_0xnsepl" name="Grupo inteiro reprovado?">
      <bpmn:incoming>Flow_1rq6lvn</bpmn:incoming>
      <bpmn:outgoing>Flow_17kv65m</bpmn:outgoing>
      <bpmn:outgoing>Flow_0vbpds9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1y5jptk" name="Relatório Final?">
      <bpmn:incoming>Flow_1sc6k8z</bpmn:incoming>
      <bpmn:incoming>Flow_0vbpds9</bpmn:incoming>
      <bpmn:outgoing>Flow_1auc5rv</bpmn:outgoing>
      <bpmn:outgoing>Flow_10ppip6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_0078yaz" name="Finalizada correção de relatórios">
      <bpmn:incoming>Flow_1bo5ect</bpmn:incoming>
      <bpmn:incoming>Flow_10ppip6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_1vk1ea5" name="Arquivar grupo">
      <bpmn:incoming>Flow_1auc5rv</bpmn:incoming>
      <bpmn:outgoing>Flow_1bo5ect</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_11r9hm5" name="Finalizada correção de relatórios">
      <bpmn:incoming>Flow_1r9wosf</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_1atjpcv" name="Arquivar grupo">
      <bpmn:documentation>Devido nenhum membro ter atingindo pontuação mínima, Grupo de Pesquisa é cancelado</bpmn:documentation>
      <bpmn:incoming>Flow_17kv65m</bpmn:incoming>
      <bpmn:outgoing>Flow_1r9wosf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Activity_14c4ba3" name="Processo de Parecer">
      <bpmn:documentation>Processo geralmente consiste de 3 etapas:
1) Envio das informações do Formulário para seu Endpoint dedicado.
2) Analise das informações pela Entidade
3) Enviar mensagem de aprovação do Formulário.

Caso seja Formulário seja rejeitado, 1 etapa extra ocorrerá:
3) Enviar mensagem de reprovação do Formulário.
4) Destacar problemas encontrados com o Formulário</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Alteracao_ComissaoPesquisa&#34;" target="Estado" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0z5vsu2</bpmn:incoming>
      <bpmn:outgoing>Flow_1kcf1a9</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_1ysp2ms" name="Adicionar à pendências">
        <bpmn:documentation>Irá adicionar informações do Formulário ao Endpoint definido à Entidade determinada na Entrada do Processo.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="adicionar-pendencias" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1d74y9m</bpmn:incoming>
        <bpmn:outgoing>Flow_05ytax5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:receiveTask id="Activity_04hwyuw" name="Parecer Realizado" messageRef="Message_1jf16ih">
        <bpmn:documentation>Entidade visualiza em lista em sua janela informações de todos os cadastros de Grupos de Pesquisa pendentes.

Entidade irá enviar mensagem definindo decisão de aprovação ou rejeição.</bpmn:documentation>
        <bpmn:incoming>Flow_05ytax5</bpmn:incoming>
        <bpmn:outgoing>Flow_12okhoj</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="Gateway_10fh20r" name="Aprovado?">
        <bpmn:documentation>Decisão define caminho a ser tomado pelo sistema.</bpmn:documentation>
        <bpmn:incoming>Flow_12okhoj</bpmn:incoming>
        <bpmn:outgoing>Flow_0a6bvxy</bpmn:outgoing>
        <bpmn:outgoing>Flow_0pc18of</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:startEvent id="Event_0lvinps" name="Início">
        <bpmn:documentation>Início do subprocesso de Parecer das Entidades responsáveis pela aprovação de Projetos.</bpmn:documentation>
        <bpmn:outgoing>Flow_1d74y9m</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_105r2we" name="Fim">
        <bpmn:documentation>Finalisação do subprocesso de Parecer</bpmn:documentation>
        <bpmn:incoming>Flow_0a6bvxy</bpmn:incoming>
        <bpmn:incoming>Flow_1ke6w6y</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1d74y9m" sourceRef="Event_0lvinps" targetRef="Activity_1ysp2ms" />
      <bpmn:sequenceFlow id="Flow_05ytax5" sourceRef="Activity_1ysp2ms" targetRef="Activity_04hwyuw" />
      <bpmn:sequenceFlow id="Flow_12okhoj" sourceRef="Activity_04hwyuw" targetRef="Gateway_10fh20r" />
      <bpmn:sequenceFlow id="Flow_0a6bvxy" name="Sim" sourceRef="Gateway_10fh20r" targetRef="Event_105r2we">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0pc18of" name="Não" sourceRef="Gateway_10fh20r" targetRef="Activity_1rzzfn8">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:task id="Activity_1rzzfn8" name="Destacar problemas">
        <bpmn:documentation>Entidade irá comentar e destacar problemas encontrados diante o Formulário em uma mensagem para o Docente.</bpmn:documentation>
        <bpmn:incoming>Flow_0pc18of</bpmn:incoming>
        <bpmn:outgoing>Flow_1ke6w6y</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_1ke6w6y" sourceRef="Activity_1rzzfn8" targetRef="Event_105r2we" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_07lrsfr" name="Processo de Parecer">
      <bpmn:documentation>Processo geralmente consiste de 3 etapas:
1) Envio das informações do Formulário para seu Endpoint dedicado.
2) Analise das informações pela Entidade
3) Enviar mensagem de aprovação do Formulário.

Caso seja Formulário seja rejeitado, 1 etapa extra ocorrerá:
3) Enviar mensagem de reprovação do Formulário.
4) Destacar problemas encontrados com o Formulário</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Alteracao_ComissaoPesquisa&#34;" target="Estado" />
          <zeebe:output source="=Porcentagem" target="CemPorCento" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kcf1a9</bpmn:incoming>
      <bpmn:outgoing>Flow_1m7bo1n</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_19v9vt0" name="Adicionar à pendências">
        <bpmn:documentation>Irá adicionar informações do Formulário ao Endpoint definido à Entidade determinada na Entrada do Processo.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="adicionar-pendencias" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_18g6sj5</bpmn:incoming>
        <bpmn:outgoing>Flow_1j8fkag</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:receiveTask id="Activity_0nb7r5i" name="Parecer Realizado" messageRef="Message_09qb2g8">
        <bpmn:documentation>Entidade visualiza em lista em sua janela informações de todos os cadastros de Grupos de Pesquisa pendentes.

Entidade irá enviar mensagem definindo decisão de aprovação ou rejeição.</bpmn:documentation>
        <bpmn:incoming>Flow_1j8fkag</bpmn:incoming>
        <bpmn:outgoing>Flow_1xmu2kl</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:startEvent id="Event_1x6v8ff" name="Início">
        <bpmn:documentation>Início do subprocesso de Parecer das Entidades responsáveis pela aprovação de Projetos.</bpmn:documentation>
        <bpmn:outgoing>Flow_18g6sj5</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0wntgcz" name="Fim">
        <bpmn:documentation>Finalisação do subprocesso de Parecer</bpmn:documentation>
        <bpmn:incoming>Flow_1xmu2kl</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_18g6sj5" sourceRef="Event_1x6v8ff" targetRef="Activity_19v9vt0" />
      <bpmn:sequenceFlow id="Flow_1j8fkag" sourceRef="Activity_19v9vt0" targetRef="Activity_0nb7r5i" />
