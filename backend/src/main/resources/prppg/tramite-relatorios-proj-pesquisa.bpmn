    <bpmn:sequenceFlow id="Flow_03asyub" name="Não" sourceRef="Gateway_1moxktg" targetRef="Activity_09ydfpz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=CemPorCento == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1sc6k8z" name="Sim" sourceRef="Gateway_1moxktg" targetRef="Gateway_1y5jptk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=CemPorCento == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1wceg17" sourceRef="Activity_09ydfpz" targetRef="Event_0scondb" />
