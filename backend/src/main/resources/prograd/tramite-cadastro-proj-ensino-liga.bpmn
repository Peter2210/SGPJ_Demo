    <bpmn:serviceTask id="Activity_0rsllwd" name="Ativar&#10;Projeto / Liga" zeebe:modelerTemplate="io.camunda.connectors.Jdbc.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>Após aprovações necessárias, será definido o Grupo de Pesquisa como ativo no banco de dados.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:connector-jdbc:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="MSSQL" target="database" />
          <zeebe:input source="uri" target="connection.authType" />
          <zeebe:input source="jdbc:sqlserver://RET-0109388206\SQLEXPRESS:1433;databaseName=BdProjetos;encrypt=false;" target="connection.uri" />
          <zeebe:input source="={user: &#34;CamundaRun&#34;, password:&#34;191195&#34;}" target="connection.uriProperties" />
          <zeebe:input source="=false" target="data.returnResults" />
          <zeebe:input source="UPDATE dbo.projetos_pesquisa SET Ativo = 1 WHERE id = :ProjetoId" target="data.query" />
          <zeebe:input source="={ProjetoId: Id}" target="data.variables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Jdbc.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
