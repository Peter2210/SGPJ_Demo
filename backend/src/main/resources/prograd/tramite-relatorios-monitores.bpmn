    <bpmn:subProcess id="Activity_0fo8kq7" name="Processo de Parecer">
      <bpmn:documentation>Processo geralmente consiste de 3 etapas:
1) Envio das informações do Formulário para seu Endpoint dedicado.
2) Analise das informações pela Entidade
3) Enviar mensagem de aprovação do Formulário.

Caso seja Formulário seja rejeitado, 1 etapa extra ocorrerá:
3) Enviar mensagem de reprovação do Formulário.
4) Destacar problemas encontrados com o Formulário

Para execução desses passos ocorrerem, é necessário que as seguintes variáveis sejam corretamente definidas:
1) Estado: Define tipo de aprovação e entidade responsável por ela, permite Backend direcionar informações para Endpoint correto.

Como saída, é definido uma variavel que receberá a mensagem de aprovação do usuário.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;Aprovacao_ComiteEticaHumano&#34;" target="Estado" />
          <zeebe:output source="=Aprovado" target="AprovadoCEH" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12suqap</bpmn:incoming>
      <bpmn:incoming>Flow_0b1cjeh</bpmn:incoming>
      <bpmn:outgoing>Flow_0b0lh5e</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_1f0927l" name="Adicionar à pendências">
        <bpmn:documentation>Irá adicionar informações do Formulário ao Endpoint definido à Entidade determinada na Entrada do Processo.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="adicionar-pendencias-aprovacao" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1phh1j1</bpmn:incoming>
        <bpmn:outgoing>Flow_1leufs0</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:receiveTask id="Activity_0e4rj7v" name="Parecer Realizado" messageRef="Message_0dlkast">
        <bpmn:documentation>Entidade visualiza em lista em sua janela informações de todos os cadastros de Grupos de Pesquisa pendentes.

Entidade irá enviar mensagem definindo decisão de aprovação ou rejeição.</bpmn:documentation>
        <bpmn:incoming>Flow_1leufs0</bpmn:incoming>
        <bpmn:outgoing>Flow_0oyai3f</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:task id="Activity_0z450wd" name="Destacar problemas">
        <bpmn:documentation>Entidade irá comentar e destacar problemas encontrados diante o Formulário em uma mensagem para o Docente.</bpmn:documentation>
        <bpmn:incoming>Flow_116vnl0</bpmn:incoming>
        <bpmn:outgoing>Flow_0ndyy3o</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="Gateway_1nlqklv" name="Aprovado?">
        <bpmn:documentation>Decisão define caminho a ser tomado pelo sistema.</bpmn:documentation>
        <bpmn:incoming>Flow_0oyai3f</bpmn:incoming>
        <bpmn:outgoing>Flow_116vnl0</bpmn:outgoing>
        <bpmn:outgoing>Flow_1wto3jq</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:startEvent id="Event_1260hz3" name="Início">
        <bpmn:documentation>Início do subprocesso de Parecer das Entidades responsáveis pela aprovação de Projetos.</bpmn:documentation>
        <bpmn:outgoing>Flow_1phh1j1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_1xervw2" name="Fim">
        <bpmn:documentation>Finalisação do subprocesso de Parecer</bpmn:documentation>
        <bpmn:incoming>Flow_0ndyy3o</bpmn:incoming>
        <bpmn:incoming>Flow_1wto3jq</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_1phh1j1" sourceRef="Event_1260hz3" targetRef="Activity_1f0927l" />
      <bpmn:sequenceFlow id="Flow_1leufs0" sourceRef="Activity_1f0927l" targetRef="Activity_0e4rj7v" />
      <bpmn:sequenceFlow id="Flow_0oyai3f" sourceRef="Activity_0e4rj7v" targetRef="Gateway_1nlqklv" />
      <bpmn:sequenceFlow id="Flow_116vnl0" name="Não" sourceRef="Gateway_1nlqklv" targetRef="Activity_0z450wd">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_0ndyy3o" sourceRef="Activity_0z450wd" targetRef="Event_1xervw2" />
      <bpmn:sequenceFlow id="Flow_1wto3jq" name="Sim" sourceRef="Gateway_1nlqklv" targetRef="Event_1xervw2">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=Aprovado=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_0dlkast" name="Aprovado">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=Id" />
    </bpmn:extensionElements>
  </bpmn:message>
